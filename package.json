{
  "name": "aciapa",
  "version": "2.0.0",
  "description": "ACIAPA — SaaS Empresarial Completo: IA + WhatsApp + CRM + Financeiro + Kanban",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "server": "node server.js",
    "frontend": "vite --port 3000",
    "build": "vite build",
    "start": "node server.js",
    "electron": "npm run build && electron electron/main.js",
    "build:exe": "npm run build && electron-builder --win nsis --x64",
    "build:portable": "npm run build && electron-builder --win portable --x64",
    "package": "build-pkg.bat"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "gerar-boletos": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.12.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.3",
    "react-router-dom": "^7.15.1",
    "socket.io": "^4.7.2",
    "svg2icon": "^1.2.4",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.5",
    "pino": "^8.17.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.383.0",
    "pkg": "^5.8.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.aciapa.app",
    "productName": "ACIAPA",
    "copyright": "Copyright © 2025-2026 ACIAPA Software Ltda. Todos os direitos reservados.",
    "publish": {
      "provider": "github",
      "owner": "lucbruna",
      "repo": "aciapa",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "ACIAPA-Setup-${version}.${ext}",
      "legalTrademarks": "ACIAPA é uma marca registrada."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ACIAPA",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "deleteAppDataOnUninstall": false,
      "language": "1046",
      "unicode": true,
      "runAfterFinish": true,
      "installerSidebar": "buildResources/installer/installer-sidebar.bmp",
      "installerHeader": "buildResources/installer/installer-header.bmp",
      "uninstallDisplayName": "ACIAPA ${version} — Gestão Empresarial Completa",
      "menuCategory": true
    },
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "db.js",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "LICENSE.txt",
      "data/",
      "uploads/",
      "auth_info/"
    ],
    "asarUnpack": [
      "server.js",
      "db.js",
      "dist/**/*",
      "electron/loading.html",
      "node_modules/better-sqlite3/**",
      "node_modules/bcryptjs/**",
      "data/**",
      "uploads/**",
      "auth_info/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "data/**/*",
      "auth_info/**/*"
    ],
    "public-packages": "better-sqlite3",
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "saas",
    "crm",
    "financeiro",
    "whatsapp",
    "ia",
    "kanban",
    "aciapa"
  ],
  "author": "ACIAPA",
  "license": "MIT"
}
